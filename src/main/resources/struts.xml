            <result name="input">/WEB-INF/jsp/magazzino/nuovoMovimento.jsp</result>
            <result name="error">/WEB-INF/jsp/magazzino/nuovoMovimento.jsp</result>
        </action>

        <!-- Storico movimenti -->
        <action name="storicoMovimenti" class="it.zensoftware.luna2.action.MagazzinoAction" method="storicoMovimenti">
            <result name="success">/WEB-INF/jsp/magazzino/storicoMovimenti.jsp</result>
            <result name="error">/WEB-INF/jsp/magazzino/storicoMovimenti.jsp</result>
        </action>

        <!-- Scanner barcode -->
        <action name="scanner" class="it.zensoftware.luna2.action.MagazzinoAction" method="scanner">
            <result name="success">/WEB-INF/jsp/magazzino/scanner.jsp</result>
        </action>

        <!-- Stampa etichette (form selezione) -->
        <action name="stampaEtichette" class="it.zensoftware.luna2.action.MagazzinoAction" method="listProdotti">
            <result name="success">/WEB-INF/jsp/magazzino/stampaEtichette.jsp</result>
            <result name="error">/WEB-INF/jsp/magazzino/stampaEtichette.jsp</result>
        </action>

        <!-- Stampa etichette (genera PDF) -->
        <action name="stampaEtichetteBatch" class="it.zensoftware.luna2.action.MagazzinoAction" method="stampaEtichette">
            <result name="success" type="stream">
                <param name="contentType">application/pdf</param>
                <param name="inputName">pdfStream</param>
                <param name="contentDisposition">attachment;filename="${pdfFileName}"</param>
                <param name="bufferSize">4096</param>
            </result>
            <result name="error">/WEB-INF/jsp/magazzino/stampaEtichette.jsp</result>
        </action>

        <!-- Stampa etichetta singola -->
        <action name="stampaEtichettaSingola" class="it.zensoftware.luna2.action.MagazzinoAction" method="stampaEtichettaSingola">
            <result name="success" type="stream">
                <param name="contentType">application/pdf</param>
                <param name="inputName">pdfStream</param>
                <param name="contentDisposition">attachment;filename="${pdfFileName}"</param>
                <param name="bufferSize">4096</param>
            </result>
            <result name="error">/WEB-INF/jsp/magazzino/list.jsp</result>
        </action>
