            <result name="success">/WEB-INF/jsp/produzione/commesse.jsp</result>
        </action>
    </package>

    <!-- Magazzino JSON Package (per azioni AJAX) -->
    <package name="magazzino-json" extends="json-default,luna2-default" namespace="/app/magazzino">
        <!-- Cerca barcode (AJAX) -->
        <action name="cercaBarcode" class="it.zensoftware.luna2.action.MagazzinoAction" method="cercaBarcode">
            <result name="success" type="json">
                <param name="root">this</param>
                <param name="includeProperties">scanResult, prodottoScansionato.*, prodottoId</param>
            </result>
            <result name="error" type="json">
                <param name="root">this</param>
                <param name="includeProperties">scanResult</param>
            </result>
        </action>
    </package>

