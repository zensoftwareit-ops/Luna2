<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Database connection settings -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/luna2?useSSL=false&amp;serverTimezone=Europe/Rome&amp;allowPublicKeyRetrieval=true</property>
        <property name="hibernate.connection.username">luna2_user</property>
        <property name="hibernate.connection.password">your_password_here</property>

        <!-- JDBC connection pool settings using C3P0 -->
        <property name="hibernate.c3p0.min_size">5</property>
        <property name="hibernate.c3p0.max_size">20</property>
        <property name="hibernate.c3p0.timeout">300</property>
        <property name="hibernate.c3p0.max_statements">50</property>
        <property name="hibernate.c3p0.idle_test_period">3000</property>

        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Drop and re-create the database schema on startup -->
        <!-- Use 'update' in production -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Enable Hibernate's automatic session context management -->
        <property name="hibernate.current_session_context_class">thread</property>

        <!-- Disable the second-level cache -->
        <property name="hibernate.cache.use_second_level_cache">false</property>
        <property name="hibernate.cache.use_query_cache">false</property>

        <!-- Entity mappings -->
        <mapping class="it.zensoftware.luna2.model.User"/>
        <mapping class="it.zensoftware.luna2.model.Cliente"/>
        <mapping class="it.zensoftware.luna2.model.Fornitore"/>
        <mapping class="it.zensoftware.luna2.model.Contatto"/>
        <mapping class="it.zensoftware.luna2.model.Prodotto"/>
        <mapping class="it.zensoftware.luna2.model.Listino"/>
        <mapping class="it.zensoftware.luna2.model.Magazzino"/>
        <mapping class="it.zensoftware.luna2.model.MovimentoMagazzino"/>
        <mapping class="it.zensoftware.luna2.model.Preventivo"/>
        <mapping class="it.zensoftware.luna2.model.PreventivoRiga"/>
        <mapping class="it.zensoftware.luna2.model.Ordine"/>
        <mapping class="it.zensoftware.luna2.model.OrdineRiga"/>
        <mapping class="it.zensoftware.luna2.model.Ddt"/>
        <mapping class="it.zensoftware.luna2.model.DdtRiga"/>
        <mapping class="it.zensoftware.luna2.model.Fattura"/>
        <mapping class="it.zensoftware.luna2.model.FatturaRiga"/>
        <mapping class="it.zensoftware.luna2.model.Lead"/>
        <mapping class="it.zensoftware.luna2.model.Nota"/>
        <mapping class="it.zensoftware.luna2.model.Scadenza"/>
        <mapping class="it.zensoftware.luna2.model.Tag"/>
        <mapping class="it.zensoftware.luna2.model.NotificationPreference"/>
        <mapping class="it.zensoftware.luna2.model.NotificationHistory"/>
        <mapping class="it.zensoftware.luna2.model.CalendarAccount"/>
        <mapping class="it.zensoftware.luna2.model.CalendarEvent"/>
    </session-factory>
</hibernate-configuration>
