<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="s" uri="/struts-tags" %>
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giacenze Magazzino - Luna2</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
</head>
<body>
    <%@ include file="../includes/sidebar.jsp" %>

    <div class="content-wrapper p-4">
        <div class="container-fluid">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3"><i class="bi bi-boxes me-2"></i>Giacenze Magazzino</h1>
                <a href="<s:url action='scanner' namespace='/app/magazzino'/>" class="btn btn-primary">
                    <i class="bi bi-upc-scan me-2"></i>Scanner Barcode
                </a>
            </div>

                <!-- Statistiche Rapide -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <h6 class="card-title">Valore Totale Magazzino</h6>
                                <h3 class="mb-0">
                                    <i class="bi bi-currency-euro"></i>
                                    <s:if test="valoreTotale != null">
                                        <s:property value="getText('{0,number,#,##0.00}', {valoreTotale})"/>
                                    </s:if>
                                    <s:else>0.00</s:else>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <h6 class="card-title">Prodotti in Magazzino</h6>
                                <h3 class="mb-0">
                                    <i class="bi bi-box-seam"></i>
                                    <s:property value="giacenze.size()"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-warning text-dark">
                            <div class="card-body">
                                <h6 class="card-title">Prodotti Sotto Scorta</h6>
                                <h3 class="mb-0">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <s:property value="sottoScorta.size()"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alert Prodotti Sotto Scorta -->
                <s:if test="sottoScorta != null && !sottoScorta.isEmpty()">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Attenzione!</strong> Ci sono <s:property value="sottoScorta.size()"/> prodotti sotto scorta minima.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </s:if>

                <!-- Messaggi -->
                <s:if test="hasActionMessages()">
                    <div class="alert alert-success alert-dismissible fade show">
                        <s:actionmessage />
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </s:if>
                <s:if test="hasActionErrors()">
                    <div class="alert alert-danger alert-dismissible fade show">
                        <s:actionerror />
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </s:if>

                <!-- Tabella Giacenze -->
                <div class="card shadow-sm">
                    <div class="card-header bg-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Elenco Giacenze</h5>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnStampaSelezionati" disabled>
                                    <i class="bi bi-printer me-1"></i>Stampa Etichette
                                </button>
                                <a href="<s:url action='storicoMovimenti' namespace='/app/magazzino'/>" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-clock-history me-1"></i>Storico
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <table id="tableGiacenze" class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selectAll" /></th>
                                    <th>Codice</th>
                                    <th>Prodotto</th>
                                    <th>Categoria</th>
                                    <th class="text-end">Giacenza</th>
                                    <th class="text-end">Disponibile</th>
                                    <th class="text-end">Impegnata</th>
                                    <th class="text-end">Valore €</th>
                                    <th>Aggiornamento</th>
                                    <th class="text-center">Azioni</th>
                                </tr>
                            </thead>
                            <tbody>
                                <s:iterator value="giacenze" var="g">
                                    <tr data-prodotto-id="<s:property value='#g.prodotto.id'/>" 
                                        class="<s:if test='#g.giacenzaDisponibile < #g.prodotto.giacenzaMinima && #g.prodotto.giacenzaMinima > 0'>table-warning</s:if>">
                                        <td>
                                            <input type="checkbox" class="row-checkbox" value="<s:property value='#g.prodotto.id'/>" />
                                        </td>
                                        <td>
                                            <code><s:property value="#g.prodotto.codice"/></code>
                                        </td>
                                        <td>
                                            <strong><s:property value="#g.prodotto.nome"/></strong>
                                        </td>
                                        <td>
                                            <s:if test="#g.prodotto.categoria != null">
                                                <span class="badge bg-secondary"><s:property value="#g.prodotto.categoria"/></span>
                                            </s:if>
                                        </td>
                                        <td class="text-end">
                                            <strong><s:property value="#g.giacenzaAttuale"/></strong>
                                        </td>
                                        <td class="text-end">
                                            <s:property value="#g.giacenzaDisponibile"/>
                                        </td>
                                        <td class="text-end">
                                            <s:property value="#g.giacenzaImpegnata"/>
                                        </td>
                                        <td class="text-end">
                                            <s:if test="#g.valoreMagazzino != null">
                                                <s:property value="getText('{0,number,#,##0.00}', {#g.valoreMagazzino})"/>
                                            </s:if>
                                            <s:else>-</s:else>
                                        </td>
                                        <td>
                                            <small><s:date name="#g.dataAggiornamento" format="dd/MM/yyyy HH:mm"/></small>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a href="<s:url action='nuovoMovimento' namespace='/app/magazzino'><s:param name='prodottoId' value='#g.prodotto.id'/><s:param name='tipoMovimento' value='"CARICO"'/></s:url>" 
                                                   class="btn btn-success" title="Carico">
                                                    <i class="bi bi-plus-circle"></i>
                                                </a>
                                                <a href="<s:url action='nuovoMovimento' namespace='/app/magazzino'><s:param name='prodottoId' value='#g.prodotto.id'/><s:param name='tipoMovimento' value='"SCARICO"'/></s:url>" 
                                                   class="btn btn-danger" title="Scarico">
                                                    <i class="bi bi-dash-circle"></i>
                                                </a>
                                                <a href="<s:url action='storicoMovimenti' namespace='/app/magazzino'><s:param name='prodottoId' value='#g.prodotto.id'/></s:url>" 
                                                   class="btn btn-info" title="Storico">
                                                    <i class="bi bi-clock-history"></i>
                                                </a>
                                                <a href="<s:url action='stampaEtichettaSingola' namespace='/app/magazzino'><s:param name='prodottoId' value='#g.prodotto.id'/></s:url>" 
                                                   class="btn btn-secondary" title="Stampa Etichetta" target="_blank">
                                                    <i class="bi bi-printer"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                </s:iterator>
                            </tbody>
                        </table>
                    </div>
                </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            // DataTable
            var table = $('#tableGiacenze').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/it-IT.json'
                },
                order: [[2, 'asc']],
                pageLength: 25
            });

            // Select All Checkbox
            $('#selectAll').on('click', function() {
                $('.row-checkbox').prop('checked', this.checked);
                updateStampaButton();
            });

            // Row Checkbox
            $('.row-checkbox').on('change', function() {
                updateStampaButton();
            });

            // Stampa Etichette Selezionati
            $('#btnStampaSelezionati').on('click', function() {
                var prodottiIds = [];
                $('.row-checkbox:checked').each(function() {
                    prodottiIds.push($(this).val());
                });

                if (prodottiIds.length > 0) {
                    var url = '<s:url action="stampaEtichette" namespace="/app/magazzino"/>' + 
                              '?prodottiSelezionati=' + prodottiIds.join('&prodottiSelezionati=') +
                              '&copiePerEtichetta=1';
                    window.open(url, '_blank');
                }
            });

            function updateStampaButton() {
                var checked = $('.row-checkbox:checked').length;
                $('#btnStampaSelezionati').prop('disabled', checked === 0);
                if (checked > 0) {
                    $('#btnStampaSelezionati').html('<i class="bi bi-printer me-1"></i>Stampa ' + checked + ' Etichette');
                } else {
                    $('#btnStampaSelezionati').html('<i class="bi bi-printer me-1"></i>Stampa Etichette');
                }
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
