# Auto detect text files and perform LF normalization
* text=auto

# Java sources
*.java text diff=java
*.properties text

# Web sources
*.jsp text
*.html text
*.css text
*.js text
*.json text
*.xml text

# SQL sources
*.sql text

# Shell scripts
*.sh text eol=lf

# Documentation
*.md text
*.txt text

# Binary files
*.jar binary
*.war binary
*.ear binary
*.class binary
*.pdf binary
*.xlsx binary
*.xls binary
*.doc binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary

# Maven
pom.xml text

# IDE
.classpath text
.project text
*.iml text
