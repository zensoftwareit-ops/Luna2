APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://api.gestionaleluna.it

# Client nominativi: client-id=token, separati da virgola. Necessari per separare
# fatture e notifiche delle diverse installazioni Luna2.
LUNA_API_CLIENTS=azienda-demo=replace-with-a-long-random-token
# Compatibilità con i soli servizi non multi-tenant (es. VAT lookup).
LUNA_API_TOKENS=
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=604800

# sandbox: test.company.openapi.com - production: company.openapi.com
OPENAPI_ENV=sandbox
OPENAPI_TOKEN=replace-with-provider-token
OPENAPI_TIMEOUT_SECONDS=12

# Conservazione cifrata dei file SdI. Usare almeno 32 caratteri casuali.
SDI_STORAGE_KEY=replace-with-a-different-long-random-secret
SDI_MAX_FILE_BYTES=5242880
SDI_REQUIRE_MTLS=true
SDI_TRUST_PROXY_MTLS=true
SDI_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Valori assegnati alle aziende Luna2: partita IVA/codice fiscale=client-id.
# Esempio: 01234567890=azienda-demo,RSSMRA80A01H501U=professionista-demo
SDI_RECIPIENT_MAP=01234567890=azienda-demo

# Endpoint e certificati del canale SDICoop. I percorsi sono assoluti sul server.
SDI_PRODUCTION_ENDPOINT=
SDI_PRODUCTION_CERT_PATH=
SDI_PRODUCTION_CERT_TYPE=PEM
SDI_PRODUCTION_KEY_PATH=
SDI_PRODUCTION_CERT_PASSWORD=
SDI_PRODUCTION_CA_PATH=

# Ambiente di accreditamento/collaudo, esposto anche tramite /test/...
SDI_TEST_ENDPOINT=
SDI_TEST_CERT_PATH=
SDI_TEST_CERT_TYPE=PEM
SDI_TEST_KEY_PATH=
SDI_TEST_CERT_PASSWORD=
SDI_TEST_CA_PATH=
