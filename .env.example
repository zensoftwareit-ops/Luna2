APP_ENV=production
APP_DEBUG=false

# Token accettati dalle installazioni Luna2, separati da virgola.
LUNA_API_TOKENS=replace-with-a-long-random-token
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=604800

# sandbox: test.company.openapi.com - production: company.openapi.com
OPENAPI_ENV=sandbox
OPENAPI_TOKEN=replace-with-provider-token
OPENAPI_TIMEOUT_SECONDS=12

