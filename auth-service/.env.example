# Auth Service Environment Variables
# Copia questo file a .env e compila i valori

# Chiave segreta per firmare lo OAuth state
# Generare con: openssl rand -base64 32
OAUTH_GOOGLE_STATE_SECRET=your-generated-base64-secret-here

# TTL dello state OAuth in secondi (default 900 per 15 minuti)
OAUTH_GOOGLE_STATE_TTL_SECONDS=900

# Log level (INFO, DEBUG, WARN, ERROR)
LOG_LEVEL=INFO
