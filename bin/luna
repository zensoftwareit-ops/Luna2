<?php

declare(strict_types=1);

use Luna\Core\Database;
use Luna\Core\Env;
use Luna\Core\LicenseService;
use Luna\Core\ModuleManager;
use Luna\Service\CalendarService;
use Luna\Service\EcommerceService;
use Luna\Service\LicenseLifecycleService;
use Luna\Service\MailService;
use Luna\Service\RentalService;
use Luna\Service\WorkspaceService;

define('BASE_PATH', dirname(__DIR__));
require BASE_PATH . '/vendor/autoload.php';
Env::load(BASE_PATH . '/.env');
date_default_timezone_set((string) Env::get('APP_TIMEZONE', 'Europe/Rome'));

$command = $argv[1] ?? 'help';

try {
    switch ($command) {
        case 'storage:init':
            foreach (['cache', 'exports', 'imports', 'logs', 'private', 'sessions'] as $directory) {
                $path = BASE_PATH . '/storage/' . $directory;
                if (!is_dir($path)) {
                    mkdir($path, 0750, true);
                }
                if (!is_file($path . '/.gitkeep')) {
                    touch($path . '/.gitkeep');
                }
            }
            echo "Storage inizializzato.\n";
            break;

        case 'key:generate':
            echo 'APP_KEY=base64:' . base64_encode(random_bytes(32)) . PHP_EOL;
            break;

        case 'migrate':
            $db = Database::connect();
            $db->exec('CREATE TABLE IF NOT EXISTS migrations (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, migration VARCHAR(190) NOT NULL UNIQUE, executed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci');
            $db->exec('CREATE TABLE IF NOT EXISTS migration_steps (migration VARCHAR(190) NOT NULL, statement_hash CHAR(64) NOT NULL, executed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (migration, statement_hash)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci');
            $applied = $db->query('SELECT migration FROM migrations')->fetchAll(PDO::FETCH_COLUMN);
            $files = glob(BASE_PATH . '/database/migrations/*.sql') ?: [];
            sort($files);
            foreach ($files as $file) {
                $name = basename($file);
                if (in_array($name, $applied, true)) {
                    echo "Già applicata: {$name}\n";
                    continue;
                }
                $sql = file_get_contents($file);
                if ($sql === false) {
                    throw new RuntimeException("Impossibile leggere {$name}");
                }
                try {
                    $statements = preg_split('/;\s*(?:\r?\n|$)/', $sql) ?: [];
                    $completedStatement = $db->prepare('SELECT 1 FROM migration_steps WHERE migration = ? AND statement_hash = ?');
                    $recordStatement = $db->prepare('INSERT IGNORE INTO migration_steps (migration, statement_hash) VALUES (?, ?)');
                    foreach ($statements as $statementIndex => $statementSql) {
                        $statementSql = trim($statementSql);
                        if ($statementSql === '') {
                            continue;
                        }
                        $statementHash = hash('sha256', $statementSql);
                        $completedStatement->execute([$name, $statementHash]);
                        if ($completedStatement->fetchColumn()) {
                            continue;
                        }
                        if ($name === '007_accounting_koinos_parity.sql' && $statementIndex === 0
                            && columnExists($db, 'chart_of_accounts', 'normal_balance')) {
                            $recordStatement->execute([$name, $statementHash]);
                            echo "Ripresa migrazione parziale: struttura iniziale gia presente.\n";
                            continue;
                        }
                        $db->exec($statementSql);
                        $recordStatement->execute([$name, $statementHash]);
                    }
                    $db->prepare('INSERT INTO migrations (migration) VALUES (?)')->execute([$name]);
                    echo "Applicata: {$name}\n";
                } catch (Throwable $e) {
                    throw new RuntimeException("Migrazione {$name} non completata: {$e->getMessage()}", 0, $e);
                }
            }
            bootstrapSuperuser($db);
            bootstrapInstanceIdentity($db);
            break;

        case 'license:status':
            $db = Database::connect();
            bootstrapInstanceIdentity($db);
            $identity = $db->query('SELECT * FROM instance_identity WHERE id = 1')->fetch();
            $license = (new LicenseService($db))->snapshot();
            echo "Identità installazione\n";
            echo '  UUID: ' . ($identity['installation_uuid'] ?? 'non disponibile') . PHP_EOL;
            echo '  Instance ID: ' . ($identity['instance_id'] ?? 'non disponibile') . PHP_EOL;
            echo '  Dominio: ' . ($identity['canonical_domain'] ?? 'non configurato') . PHP_EOL;
            echo "Licenza\n";
            echo '  Stato: ' . ($license['effective_status'] ?? 'UNCONFIGURED') . PHP_EOL;
            echo '  Piano: ' . ($license['plan_code'] ?? 'non configurato') . PHP_EOL;
            echo '  Utenti massimi: ' . ($license['max_users'] ?? 'non configurato') . PHP_EOL;
            echo '  Moduli: ' . (($license['modules'] ?? []) === [] ? 'nessuno' : implode(', ', $license['modules'])) . PHP_EOL;
            echo '  Enforcement: ' . (new LicenseService($db))->enforcement() . PHP_EOL;
            break;

        case 'license:sync':
            $db = Database::connect();
            $payload = (new LicenseLifecycleService($db))->sync();
            echo 'Licenza sincronizzata. Stato: ' . ($payload['status'] ?? 'sconosciuto') . ', piano: ' . ($payload['plan_code'] ?? 'sconosciuto') . PHP_EOL;
            break;

        case 'cron:license':
            $db = Database::connect();
            $lifecycle = new LicenseLifecycleService($db);
            if (!$lifecycle->dueForSync()) {
                echo "Nessuna sincronizzazione licenza necessaria.\n";
                break;
            }
            $payload = $lifecycle->sync();
            echo 'Sincronizzazione licenza completata: ' . ($payload['status'] ?? 'sconosciuto') . PHP_EOL;
            break;

        case 'cron:daily':
            $db = Database::connect();
            try {
                $licenseLifecycle = new LicenseLifecycleService($db);
                if ($licenseLifecycle->dueForSync()) {
                    $licenseLifecycle->sync();
                    echo "Licenza sincronizzata.\n";
                }
            } catch (Throwable $exception) {
                echo 'Avviso licenza: ' . $exception->getMessage() . PHP_EOL;
            }
            $licenseService = new LicenseService($db);
            if (!$licenseService->operationAllowed('WRITE')) {
                echo "Licenza in modalità limitata: aggiornamenti e job in uscita sospesi. Consultazione ed export restano disponibili.\n";
                break;
            }
            $tax = $db->exec("UPDATE tax_deadlines SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND status IN ('OPEN','IN_PROGRESS')");
            $documents = $db->exec("UPDATE documents SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND balance_due > 0 AND status IN ('ISSUED','RECEIVED','PARTIALLY_PAID')");
            $rental = $db->exec("UPDATE rental_deadlines SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND status = 'OPEN'");
            $organizations = $db->query('SELECT id FROM organizations WHERE active = 1')->fetchAll(PDO::FETCH_COLUMN);
            $jobs = ['mail_sent' => 0, 'commerce' => 0, 'calendar' => 0, 'rental_invoices' => 0, 'notifications' => 0, 'errors' => 0];
            $features = require BASE_PATH . '/config/features.php';
            foreach ($organizations as $organizationId) {
                $modules = new ModuleManager($db, $features, (int) $organizationId);
                if ($modules->operationallyEnabled('communications')) {
                    try { $result = (new MailService($db, (int) $organizationId))->processQueue(50); $jobs['mail_sent'] += $result['sent']; } catch (Throwable) { $jobs['errors']++; }
                }
                if ($modules->operationallyEnabled('ecommerce')) {
                    try { $result = (new EcommerceService($db, (int) $organizationId))->processQueue(25); $jobs['commerce'] += $result['processed']; } catch (Throwable) { $jobs['errors']++; }
                }
                if ($modules->operationallyEnabled('calendar')) {
                    try { $result = (new CalendarService($db, (int) $organizationId))->syncAll(); $jobs['calendar'] += $result['ok']; $jobs['errors'] += $result['failed']; } catch (Throwable) { $jobs['errors']++; }
                }
                if ($modules->operationallyEnabled('rental')) {
                    try { $result = (new RentalService($db, (int) $organizationId))->runAutomations(); $jobs['rental_invoices'] += $result['invoices']; } catch (Throwable) { $jobs['errors']++; }
                }
                try { $jobs['notifications'] += (new WorkspaceService($db, (int) $organizationId, 0))->refreshOperationalNotifications(); } catch (Throwable) { $jobs['errors']++; }
            }
            echo "Scadenze: fiscali {$tax}, documenti {$documents}, noleggio {$rental}. Job: mail {$jobs['mail_sent']}, e-commerce {$jobs['commerce']}, calendari {$jobs['calendar']}, fatture noleggio {$jobs['rental_invoices']}, notifiche {$jobs['notifications']}, errori {$jobs['errors']}.\n";
            break;

        default:
            echo "Luna2 CLI\n\n";
            echo "  storage:init\n  key:generate\n  migrate\n  license:status\n  license:sync\n  cron:license\n  cron:daily\n";
    }
} catch (Throwable $exception) {
    fwrite(STDERR, 'Errore: ' . $exception->getMessage() . PHP_EOL);
    exit(1);
}

function bootstrapSuperuser(PDO $db): void
{
    $existing = $db->query("SELECT email FROM users WHERE role = 'SUPERUSER' ORDER BY id LIMIT 1")->fetchColumn();
    if ($existing !== false) {
        echo "Superuser già presente: {$existing}\n";
        return;
    }

    $email = mb_strtolower(trim((string) Env::get('SUPERUSER_EMAIL', 'superuser@luna.local')));
    $emailInUse = $db->prepare('SELECT COUNT(*) FROM users WHERE email = ?');
    $emailInUse->execute([$email]);
    if ((int) $emailInUse->fetchColumn() > 0) {
        throw new RuntimeException("L'indirizzo SUPERUSER_EMAIL {$email} è già utilizzato da un altro utente.");
    }

    $password = rtrim(strtr(base64_encode(random_bytes(18)), '+/', '-_'), '=');
    $hash = password_hash($password, PASSWORD_ARGON2ID);
    if ($hash === false) {
        throw new RuntimeException('Impossibile generare la password del superuser.');
    }

    $db->beginTransaction();
    try {
        $db->prepare("INSERT INTO organizations (business_name, active) VALUES ('Luna2 Platform', 1)")->execute();
        $platformOrganizationId = (int) $db->lastInsertId();
        $db->prepare(
            "INSERT INTO users (organization_id, name, email, password_hash, role, active)
             VALUES (?, 'Superuser Luna2', ?, ?, 'SUPERUSER', 1)"
        )->execute([$platformOrganizationId, $email, $hash]);
        $db->commit();
    } catch (Throwable $exception) {
        if ($db->inTransaction()) {
            $db->rollBack();
        }
        throw $exception;
    }

    echo "\n=== CREDENZIALI SUPERUSER (mostrate una sola volta) ===\n";
    echo "Email: {$email}\n";
    echo "Password: {$password}\n";
    echo "Conserva ora queste credenziali in un password manager.\n";
    echo "========================================================\n";
}

function columnExists(PDO $db, string $table, string $column): bool
{
    $statement = $db->prepare(
        'SELECT 1 FROM information_schema.COLUMNS
         WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = ? AND COLUMN_NAME = ?'
    );
    $statement->execute([$table, $column]);
    return (bool) $statement->fetchColumn();
}

function bootstrapInstanceIdentity(PDO $db): void
{
    if (!tableExists($db, 'instance_identity')) {
        return;
    }
    $url = (string) Env::get('APP_URL', '');
    $domain = parse_url($url, PHP_URL_HOST) ?: null;
    $existing = $db->query('SELECT installation_uuid FROM instance_identity WHERE id = 1')->fetchColumn();
    if ($existing !== false) {
        $db->prepare('UPDATE instance_identity SET canonical_domain = COALESCE(?, canonical_domain), software_version = ?, last_seen_at = NOW() WHERE id = 1')
            ->execute([$domain, '6.3.0-php']);
        return;
    }

    $bytes = random_bytes(16);
    $bytes[6] = chr((ord($bytes[6]) & 0x0f) | 0x40);
    $bytes[8] = chr((ord($bytes[8]) & 0x3f) | 0x80);
    $hex = bin2hex($bytes);
    $uuid = sprintf('%s-%s-%s-%s-%s', substr($hex, 0, 8), substr($hex, 8, 4), substr($hex, 12, 4), substr($hex, 16, 4), substr($hex, 20));
    $instanceId = 'luna2-' . substr(hash('sha256', $uuid), 0, 20);
    $db->prepare(
        'INSERT INTO instance_identity (id, installation_uuid, instance_id, canonical_domain, environment, software_version, installed_at, last_seen_at)
         VALUES (1, ?, ?, ?, ?, ?, NOW(), NOW())'
    )->execute([$uuid, $instanceId, $domain, (string) Env::get('APP_ENV', 'production'), '6.3.0-php']);
    echo "Identità installazione creata: {$instanceId}\n";
}

function tableExists(PDO $db, string $table): bool
{
    $statement = $db->prepare(
        'SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = ?'
    );
    $statement->execute([$table]);
    return (bool) $statement->fetchColumn();
}
