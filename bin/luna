<?php

declare(strict_types=1);

use Luna\Core\Database;
use Luna\Core\Env;

define('BASE_PATH', dirname(__DIR__));
require BASE_PATH . '/vendor/autoload.php';
Env::load(BASE_PATH . '/.env');
date_default_timezone_set((string) Env::get('APP_TIMEZONE', 'Europe/Rome'));

$command = $argv[1] ?? 'help';

try {
    switch ($command) {
        case 'storage:init':
            foreach (['cache', 'imports', 'logs', 'private', 'sessions'] as $directory) {
                $path = BASE_PATH . '/storage/' . $directory;
                if (!is_dir($path)) {
                    mkdir($path, 0750, true);
                }
                if (!is_file($path . '/.gitkeep')) {
                    touch($path . '/.gitkeep');
                }
            }
            echo "Storage inizializzato.\n";
            break;

        case 'key:generate':
            echo 'APP_KEY=base64:' . base64_encode(random_bytes(32)) . PHP_EOL;
            break;

        case 'migrate':
            $db = Database::connect();
            $db->exec('CREATE TABLE IF NOT EXISTS migrations (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, migration VARCHAR(190) NOT NULL UNIQUE, executed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci');
            $applied = $db->query('SELECT migration FROM migrations')->fetchAll(PDO::FETCH_COLUMN);
            $files = glob(BASE_PATH . '/database/migrations/*.sql') ?: [];
            sort($files);
            foreach ($files as $file) {
                $name = basename($file);
                if (in_array($name, $applied, true)) {
                    echo "Già applicata: {$name}\n";
                    continue;
                }
                $sql = file_get_contents($file);
                if ($sql === false) {
                    throw new RuntimeException("Impossibile leggere {$name}");
                }
                try {
                    $statements = preg_split('/;\s*(?:\r?\n|$)/', $sql) ?: [];
                    foreach ($statements as $statementSql) {
                        if (trim($statementSql) !== '') {
                            $db->exec($statementSql);
                        }
                    }
                    $db->prepare('INSERT INTO migrations (migration) VALUES (?)')->execute([$name]);
                    echo "Applicata: {$name}\n";
                } catch (Throwable $e) {
                    throw new RuntimeException("Migrazione {$name} non completata: {$e->getMessage()}", 0, $e);
                }
            }
            bootstrapSuperuser($db);
            break;

        case 'cron:daily':
            $db = Database::connect();
            $tax = $db->exec("UPDATE tax_deadlines SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND status IN ('OPEN','IN_PROGRESS')");
            $documents = $db->exec("UPDATE documents SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND balance_due > 0 AND status IN ('ISSUED','RECEIVED','PARTIALLY_PAID')");
            $rental = $db->exec("UPDATE rental_deadlines SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND status = 'OPEN'");
            echo "Aggiornate scadenze: fiscali {$tax}, documenti {$documents}, noleggio {$rental}.\n";
            break;

        default:
            echo "Luna2 CLI\n\n";
            echo "  storage:init\n  key:generate\n  migrate\n  cron:daily\n";
    }
} catch (Throwable $exception) {
    fwrite(STDERR, 'Errore: ' . $exception->getMessage() . PHP_EOL);
    exit(1);
}

function bootstrapSuperuser(PDO $db): void
{
    $existing = $db->query("SELECT email FROM users WHERE role = 'SUPERUSER' ORDER BY id LIMIT 1")->fetchColumn();
    if ($existing !== false) {
        echo "Superuser già presente: {$existing}\n";
        return;
    }

    $email = mb_strtolower(trim((string) Env::get('SUPERUSER_EMAIL', 'superuser@luna.local')));
    $emailInUse = $db->prepare('SELECT COUNT(*) FROM users WHERE email = ?');
    $emailInUse->execute([$email]);
    if ((int) $emailInUse->fetchColumn() > 0) {
        throw new RuntimeException("L'indirizzo SUPERUSER_EMAIL {$email} è già utilizzato da un altro utente.");
    }

    $password = rtrim(strtr(base64_encode(random_bytes(18)), '+/', '-_'), '=');
    $hash = password_hash($password, PASSWORD_ARGON2ID);
    if ($hash === false) {
        throw new RuntimeException('Impossibile generare la password del superuser.');
    }

    $db->beginTransaction();
    try {
        $db->prepare("INSERT INTO organizations (business_name, active) VALUES ('Luna2 Platform', 1)")->execute();
        $platformOrganizationId = (int) $db->lastInsertId();
        $db->prepare(
            "INSERT INTO users (organization_id, name, email, password_hash, role, active)
             VALUES (?, 'Superuser Luna2', ?, ?, 'SUPERUSER', 1)"
        )->execute([$platformOrganizationId, $email, $hash]);
        $db->commit();
    } catch (Throwable $exception) {
        if ($db->inTransaction()) {
            $db->rollBack();
        }
        throw $exception;
    }

    echo "\n=== CREDENZIALI SUPERUSER (mostrate una sola volta) ===\n";
    echo "Email: {$email}\n";
    echo "Password: {$password}\n";
    echo "Conserva ora queste credenziali in un password manager.\n";
    echo "========================================================\n";
}
