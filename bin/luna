<?php

declare(strict_types=1);

use Luna\Core\Database;
use Luna\Core\Env;

define('BASE_PATH', dirname(__DIR__));
require BASE_PATH . '/vendor/autoload.php';
Env::load(BASE_PATH . '/.env');
date_default_timezone_set((string) Env::get('APP_TIMEZONE', 'Europe/Rome'));

$command = $argv[1] ?? 'help';

try {
    switch ($command) {
        case 'storage:init':
            foreach (['cache', 'imports', 'logs', 'private', 'sessions'] as $directory) {
                $path = BASE_PATH . '/storage/' . $directory;
                if (!is_dir($path)) {
                    mkdir($path, 0750, true);
                }
                if (!is_file($path . '/.gitkeep')) {
                    touch($path . '/.gitkeep');
                }
            }
            echo "Storage inizializzato.\n";
            break;

        case 'key:generate':
            echo 'APP_KEY=base64:' . base64_encode(random_bytes(32)) . PHP_EOL;
            break;

        case 'migrate':
            $db = Database::connect();
            $db->exec('CREATE TABLE IF NOT EXISTS migrations (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, migration VARCHAR(190) NOT NULL UNIQUE, executed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci');
            $applied = $db->query('SELECT migration FROM migrations')->fetchAll(PDO::FETCH_COLUMN);
            $files = glob(BASE_PATH . '/database/migrations/*.sql') ?: [];
            sort($files);
            foreach ($files as $file) {
                $name = basename($file);
                if (in_array($name, $applied, true)) {
                    echo "Già applicata: {$name}\n";
                    continue;
                }
                $sql = file_get_contents($file);
                if ($sql === false) {
                    throw new RuntimeException("Impossibile leggere {$name}");
                }
                try {
                    $statements = preg_split('/;\s*(?:\r?\n|$)/', $sql) ?: [];
                    foreach ($statements as $statementSql) {
                        if (trim($statementSql) !== '') {
                            $db->exec($statementSql);
                        }
                    }
                    $db->prepare('INSERT INTO migrations (migration) VALUES (?)')->execute([$name]);
                    echo "Applicata: {$name}\n";
                } catch (Throwable $e) {
                    throw new RuntimeException("Migrazione {$name} non completata: {$e->getMessage()}", 0, $e);
                }
            }
            break;

        case 'setup:admin':
            $businessName = $argv[2] ?? null;
            $email = $argv[3] ?? null;
            $password = $argv[4] ?? null;
            $name = $argv[5] ?? 'Amministratore';
            if (!$businessName || !$email || !$password || strlen($password) < 12) {
                throw new InvalidArgumentException('Uso: php bin/luna setup:admin "Ragione Sociale" email password-lunga [Nome]');
            }
            $db = Database::connect();
            $db->beginTransaction();
            $db->prepare('INSERT INTO organizations (business_name) VALUES (?)')->execute([$businessName]);
            $organizationId = (int) $db->lastInsertId();
            $hash = password_hash($password, PASSWORD_ARGON2ID);
            $db->prepare("INSERT INTO users (organization_id, name, email, password_hash, role) VALUES (?, ?, ?, ?, 'OWNER')")
                ->execute([$organizationId, $name, mb_strtolower($email), $hash]);
            seedCore($db, $organizationId);
            $db->commit();
            echo "Azienda #{$organizationId} e amministratore creati.\n";
            break;

        case 'cron:daily':
            $db = Database::connect();
            $tax = $db->exec("UPDATE tax_deadlines SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND status IN ('OPEN','IN_PROGRESS')");
            $documents = $db->exec("UPDATE documents SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND balance_due > 0 AND status IN ('ISSUED','RECEIVED','PARTIALLY_PAID')");
            $rental = $db->exec("UPDATE rental_deadlines SET status = 'OVERDUE', updated_at = NOW() WHERE due_date < CURRENT_DATE() AND status = 'OPEN'");
            echo "Aggiornate scadenze: fiscali {$tax}, documenti {$documents}, noleggio {$rental}.\n";
            break;

        default:
            echo "Luna2 CLI\n\n";
            echo "  storage:init\n  key:generate\n  migrate\n  setup:admin \"Ragione Sociale\" email password [Nome]\n  cron:daily\n";
    }
} catch (Throwable $exception) {
    fwrite(STDERR, 'Errore: ' . $exception->getMessage() . PHP_EOL);
    exit(1);
}

function seedCore(PDO $db, int $organizationId): void
{
    $accounts = [
        ['1000', 'Crediti verso clienti', 'ASSET', 'TRADE_RECEIVABLES'],
        ['1100', 'Banca c/c', 'ASSET', 'BANK'],
        ['1200', 'IVA a credito', 'ASSET', 'VAT_RECEIVABLE'],
        ['2000', 'Debiti verso fornitori', 'LIABILITY', 'TRADE_PAYABLES'],
        ['2100', 'IVA a debito', 'LIABILITY', 'VAT_PAYABLE'],
        ['3000', 'Patrimonio netto', 'EQUITY', 'EQUITY'],
        ['4000', 'Ricavi vendite e prestazioni', 'REVENUE', 'SALES_REVENUE'],
        ['5000', 'Costi per acquisti e servizi', 'EXPENSE', 'PURCHASE_COSTS'],
    ];
    $statement = $db->prepare('INSERT INTO chart_of_accounts (organization_id, code, name, account_type, system_key, is_postable, active) VALUES (?, ?, ?, ?, ?, 1, 1)');
    foreach ($accounts as $account) {
        $statement->execute(array_merge([$organizationId], $account));
    }
    $vatCodes = [
        ['22', 'IVA ordinaria 22%', 22, null, null],
        ['10', 'IVA ridotta 10%', 10, null, null],
        ['5', 'IVA ridotta 5%', 5, null, null],
        ['4', 'IVA ridotta 4%', 4, null, null],
        ['N1', 'Escluse ex art. 15', 0, 'N1', 'Art. 15 DPR 633/72'],
        ['N2.2', 'Non soggette - altri casi', 0, 'N2.2', null],
        ['N3.5', 'Non imponibili - dichiarazioni intento', 0, 'N3.5', null],
        ['N4', 'Operazioni esenti', 0, 'N4', 'Art. 10 DPR 633/72'],
        ['N6.7', 'Reverse charge - edilizia', 0, 'N6.7', null],
    ];
    $statement = $db->prepare('INSERT INTO vat_codes (organization_id, code, description, rate, nature, legal_reference) VALUES (?, ?, ?, ?, ?, ?)');
    foreach ($vatCodes as $vatCode) {
        $statement->execute(array_merge([$organizationId], $vatCode));
    }
    $db->prepare("INSERT INTO warehouses (organization_id, code, name, active) VALUES (?, 'MAIN', 'Magazzino principale', 1)")->execute([$organizationId]);
    $stages = [['Nuovo', 10], ['Contattato', 20], ['Qualificato', 40], ['Proposta', 60], ['Negoziazione', 80], ['Vinto', 100]];
    $statement = $db->prepare('INSERT INTO pipeline_stages (organization_id, name, position, probability, won) VALUES (?, ?, ?, ?, ?)');
    foreach ($stages as $position => [$name, $probability]) {
        $statement->execute([$organizationId, $name, $position + 1, $probability, $name === 'Vinto' ? 1 : 0]);
    }
}
